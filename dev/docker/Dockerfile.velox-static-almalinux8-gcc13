ARG BASE_IMAGE=apache/gluten:vcpkg-almalinux-8-gcc13
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG VELOX_COMMIT
ARG VELOX_KEY

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The key command requires a digest-pinned base and verifies the checkout before building.
# Keep the entire Velox build tree, and its vcpkg dependencies at their original paths.
RUN --mount=type=bind,source=.,target=/source \
    set -eux; \
    dnf module -y install python39; \
    alternatives --set python3 /usr/bin/python3.9; \
    source /opt/rh/gcc-toolset-13/enable; \
    python3.9 /source/dev/ci-velox-key.py build --repository-root=/source \
      --base-image="${BASE_IMAGE}" --velox-commit="${VELOX_COMMIT}" --expected-key="${VELOX_KEY}"; \
    dnf clean all; \
    du -sh /opt/velox /opt/gluten/dev/vcpkg
