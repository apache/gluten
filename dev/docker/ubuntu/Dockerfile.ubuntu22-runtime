# Runtime image for the Ubuntu TPC jobs, which check that the static native library runs on a
# plain Ubuntu. It adds only JDKs, CI tools, Hadoop and MinIO to the OS image, no native
# libraries. All JDKs are installed side by side under /usr/lib/jvm/java-<N>-openjdk-<arch>;
# jobs select one through JAVA_HOME instead of installing it at runtime.
# Produces the apache/gluten:ubuntu-22.04-runtime image.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/GMT
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN --mount=type=bind,source=dev/docker/install-ci-tools.sh,target=/tmp/install-ci-tools.sh \
    --mount=type=bind,source=.github/workflows/util/install-spark-deps.sh,target=/tmp/install-spark-deps.sh \
    set -ex; \
    apt-get update; \
    apt-get install -y --no-install-recommends tzdata ca-certificates curl wget git procps \
        python3 python3-pip openjdk-8-jdk openjdk-11-jdk openjdk-17-jdk openjdk-21-jdk openjdk-25-jdk; \
    python3 -m pip install --no-cache-dir requests; \
    bash /tmp/install-ci-tools.sh; \
    # Hadoop (/opt/hadoop-<version>) and MinIO for the HDFS and S3 TPC runs.
    cd /opt; bash -ec 'source /tmp/install-spark-deps.sh; \
    download_hadoop 3.3.6; \ 
    install_minio'; \
    ls /usr/lib/jvm /opt; \
    rm -rf /var/lib/apt/lists/*
