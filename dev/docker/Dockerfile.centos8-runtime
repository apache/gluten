# Runtime image for the CentOS 8 TPC jobs, which check that the static native library runs on a
# plain CentOS 8. It adds only JDKs, CI tools and Celeborn releases to the OS image, no native
# libraries. All JDKs are installed side by side under /usr/lib/jvm/java-<version>-openjdk; jobs
# select one through JAVA_HOME instead of installing it at runtime.
# Produces the apache/gluten:centos-8-runtime image.
FROM centos:8

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN --mount=type=bind,source=dev/docker/install-ci-tools.sh,target=/tmp/install-ci-tools.sh \
    set -ex; \
    sed -i -e "s|mirrorlist=|#mirrorlist=|g" /etc/yum.repos.d/CentOS-* || true; \
    sed -i -e "s|#baseurl=http://mirror.centos.org|baseurl=https://vault.centos.org|g" /etc/yum.repos.d/CentOS-* || true; \
    yum update -y; \
    yum install -y java-1.8.0-openjdk-devel java-11-openjdk-devel java-17-openjdk-devel \
        wget curl tar gzip git procps-ng which findutils tzdata python3; \
    bash /tmp/install-ci-tools.sh; \
    # Celeborn releases for the Celeborn TPC job; downloading them at runtime is throttled.
    mirror_host="https://www.apache.org/dyn/closer.lua"; \
    wget -nv ${mirror_host}/celeborn/celeborn-0.5.4/apache-celeborn-0.5.4-bin.tgz?action=download -O /opt/apache-celeborn-0.5.4-bin.tgz; \
    wget -nv ${mirror_host}/celeborn/celeborn-0.6.3/apache-celeborn-0.6.3-bin.tgz?action=download -O /opt/apache-celeborn-0.6.3-bin.tgz; \
    yum clean all; \
    rm -rf /var/cache/yum /var/cache/dnf
