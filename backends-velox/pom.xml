                    <spark.ui.enabled>false</spark.ui.enabled>
                    <spark.gluten.ui.enabled>false</spark.gluten.ui.enabled>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
