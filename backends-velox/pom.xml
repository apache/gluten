                    <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                    <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
                    <junit.jupiter.execution.order.random.seed>0</junit.jupiter.execution.order.random.seed>
                    <gluten.iceberg.coverage.dir>${iceberg.upstream.reports}</gluten.iceberg.coverage.dir>
                    <spark.memory.offHeap.enabled>true</spark.memory.offHeap.enabled>
