#
# Apache RAT exclusions for the source release. Each line is a regular expression
# matched against a file or directory name (not a path); a matching directory
# excludes everything below it. Usage:
#   java -jar apache-rat-<version>.jar -E .rat-excludes -d <source dir>
# Only markdown docs, test data, golden files, generated output and third-party files
# belong here. Other Gluten-authored files must carry the ASF license header instead.

\.rat-excludes
\.gitignore
\.gitattributes
\.gitmodules
\.gitkeep
\.github
\.idea
target
.*\.md
LICENSE-binary
NOTICE-binary
sql-tests
tpcds-plan-stability
gluten-tpch-plan-stability
tpch-approved-plan
tpcds-queries.*
tpch-queries.*
tpcds-decimal-queries-output
clickbench-queries
queries
result
csv-data
text-data
nexmark
event-files
junit[0-9]+
.*\.csv
.*\.tsv
.*Benchmark-results\.txt
ports
.*\.patch
config\.guess
config\.sub
check-style
\.clang-format
emon\.list
